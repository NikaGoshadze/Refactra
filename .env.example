# Local-only development credentials. Do not reuse for a deployment.
POSTGRES_USER=refactra
POSTGRES_PASSWORD=refactra_local
POSTGRES_DB=refactra
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=3000
# Host development only; Compose supplies its own internal database address.
REFACTRA_DATABASE_URL=postgresql+psycopg://refactra:refactra_local@localhost:5433/refactra
REFACTRA_ENABLE_MOCK=true
REFACTRA_API_URL=http://127.0.0.1:8000
# development or production; production refuses to start with unsafe settings (see README).
REFACTRA_ENVIRONMENT=development
# Spending limits, in UTC days and months: runs per user per day, model cost per user per
# month, and the overall monthly model budget.
REFACTRA_USER_DAILY_RUNS=5
REFACTRA_USER_MONTHLY_USD=3
REFACTRA_MONTHLY_USD=12

# Optional local GitHub App sign-in. OAuth secrets are API-only.
# Use the App's Client ID, not its App ID. Keep the two secrets out of Git.
REFACTRA_GITHUB_CLIENT_ID=
REFACTRA_GITHUB_CLIENT_SECRET=
REFACTRA_GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
# The App's URL name from https://github.com/apps/<slug>; enables the "Install on GitHub" link.
REFACTRA_GITHUB_APP_SLUG=
# scripts/prepare-local-env.py generates these two keys when creating .env. The second
# encrypts each signed-in user's GitHub token; changing it signs everyone out of GitHub access.
REFACTRA_OAUTH_STATE_SECRET=
REFACTRA_TOKEN_ENCRYPTION_KEY=

# Save the App's downloaded PEM as .runtime/secrets/github-app.pem. Users pick repositories in
# the workspace; Refactra looks up the App installation for each one.

# Local eligibility policy: comma-separated numeric GitHub user IDs; empty denies all.
# Pass this to the API by opting into compose.repository-api.yaml.
REFACTRA_ALLOWED_GITHUB_USER_IDS=

# Optional operator-only model check; never expose this to the browser or target sandbox.
REFACTRA_OPENAI_API_KEY=
REFACTRA_DEEPSEEK_API_KEY=
# Download the pinned tokenizer documented in README; keep it local/ignored.
REFACTRA_DEEPSEEK_TOKENIZER_PATH=.runtime/deepseek-v41-tokenizer.json
