# Local-only development credentials. Do not reuse for a deployment.
POSTGRES_USER=refactra
POSTGRES_PASSWORD=refactra_local
POSTGRES_DB=refactra
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=3000
# Host development only; Compose supplies its own internal database address.
REFACTRA_DATABASE_URL=postgresql+psycopg://refactra:refactra_local@localhost:5433/refactra
REFACTRA_ENABLE_MOCK=true
REFACTRA_API_URL=http://127.0.0.1:8000
